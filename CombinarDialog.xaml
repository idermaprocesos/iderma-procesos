<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Iderma_Procesos.CombinarDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Combinar procedimientos"
    PrimaryButtonText="Generar Word"
    SecondaryButtonText="Generar PDF"
    CloseButtonText="Cancelar"
    DefaultButton="Primary">

    <StackPanel Width="460" Spacing="12">
        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="Marque los procedimientos y defina el orden. Cada uno conserva su encabezado; el resto del formato se mantiene."
            TextWrapping="Wrap" />
        <TextBlock
            x:Name="Mensaje"
            Foreground="{ThemeResource SystemFillColorCautionBrush}"
            Text="Seleccione al menos un procedimiento."
            Visibility="Collapsed" />
        <ListView
            x:Name="Lista"
            MaxHeight="360"
            AllowDrop="True"
            CanReorderItems="True"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="0,4" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox
                            VerticalAlignment="Center"
                            IsChecked="{Binding Incluido, Mode=TwoWay}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="{Binding Codigo}" />
                            <TextBlock
                                MaxLines="2"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding Titulo}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            Padding="8,6"
                            VerticalAlignment="Center"
                            Click="Subir_Click"
                            Tag="{Binding}"
                            ToolTipService.ToolTip="Subir">
                            <FontIcon FontSize="12" Glyph="&#xE70E;" />
                        </Button>
                        <Button
                            Grid.Column="3"
                            Padding="8,6"
                            VerticalAlignment="Center"
                            Click="Bajar_Click"
                            Tag="{Binding}"
                            ToolTipService.ToolTip="Bajar">
                            <FontIcon FontSize="12" Glyph="&#xE70D;" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</ContentDialog>
